+/// Compute the ID of a decompressed circuit file, as lowercase hex.
+///
+/// The circuit is decompressed, as everywhere else in this API; google/longfellow-zk's C
+/// `circuit_id` takes the compressed bytes instead.
+#[uniffi::export]
+pub fn mdoc_circuit_id(circuit: &[u8]) -> Result<String, MdocZkError> {
+    crate::mdoc_zk::mdoc_circuit_id(circuit)
+        .map(|id| hex::encode(id.0))
+        .map_err(MdocZkError)
+}
