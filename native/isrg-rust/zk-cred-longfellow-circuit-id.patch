+/// Compute the ID of a decompressed circuit file, matching how [`longfellow-zk`][1] does it.
+///
+/// The file holds the signature circuit followed by the hash circuit; the ID is the SHA-256 of
+/// their two circuit IDs concatenated. Trailing bytes are an error.
+///
+/// [1]: https://github.com/google/longfellow-zk/blob/v0.9/lib/circuits/mdoc/mdoc_circuit_id.cc
+pub fn mdoc_circuit_id(circuit: &[u8]) -> Result<Sha256Digest, anyhow::Error> {
+    let mut cursor = Cursor::new(circuit);
+    let signature_circuit = Circuit::<FieldP256>::decode(&mut cursor)?;
+    let hash_circuit = Circuit::<Field2_128>::decode(&mut cursor)?;
+    if cursor.position() as usize != circuit.len() {
+        return Err(anyhow!("extra data left over after decoding circuits"));
+    }
+
+    let mut digest = Sha256::new();
+    digest.update(signature_circuit.circuit_id()?.0);
+    digest.update(hash_circuit.circuit_id()?.0);
+
+    Ok(Sha256Digest(digest.finalize().into()))
+}
